genoma_referencia/

# Base de datos BLAST indexada (~788 MB)
blast_db/

# Herramientas BLAST+ (~375 MB)
blast_local/

# VCFs del Proyecto 1000 Genomas (~2.4 GB)
datos_1000genomes/

