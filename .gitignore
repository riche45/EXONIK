reporte_integrado/reporte_clinico_HG02594.html
reporte_integrado/reporte_clinico_HG02923.html

# Secuencias completas de guías y ARNm — IP sensible
reporte_integrado/secuencias_laboratorio.txt

# ─────────────────────────────────────────────
# 🐍 Python — Caché y entornos
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
.env

